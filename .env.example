# Copy to .env and fill in values.
# .env is gitignored — never commit real passwords.

# --- Local MySQL (clinic PC) ---
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=root
# MYSQL_DATABASE=eye_clinic
# (leave STORE_FILES_IN_DB unset for local disk uploads)

# --- Oracle HeatWave via NLB (Render cloud) ---
MYSQL_HOST=YOUR_NLB_PUBLIC_IP
MYSQL_PORT=3306
MYSQL_USER=clinicadmin
MYSQL_PASSWORD=YOUR_HEATWAVE_PASSWORD
MYSQL_DATABASE=eye_clinic
MYSQL_SSL=1
STORE_FILES_IN_DB=1

# Clinic login password (app UI)
CLINIC_PASSWORD=clinic123

# Optional: how many ZIP backups to keep (default 7 in cloud, 14 on disk)
# BACKUP_KEEP=7

# --- Google Drive daily offsite backup (recommended for HeatWave) ---
# 1) Enable Drive API + create a service account JSON key
# 2) Share a Drive folder with the service account email (Editor)
# 3) Paste folder ID + JSON (or base64 JSON) below
# Uploads daily at 01:00 Asia/Colombo; deletes previous daily file after success.
# GOOGLE_DRIVE_FOLDER_ID=
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=
# BACKUP_CRON_SECRET=long-random-secret
# GOOGLE_DRIVE_BACKUP=1

# Hosting: docs/HOSTING.md
# Export local → import HeatWave:
#   npm run export:local
#   npm run import:heatwave
