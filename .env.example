# Copy to .env and fill in your MySQL password
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=eye_clinic

# Clinic login password (app UI)
CLINIC_PASSWORD=clinic123

# TLS to MySQL (Aiven / Oracle HeatWave via NLB). Not needed for local MySQL.
# MYSQL_SSL=1

# On hosts with ephemeral disks (e.g. Render), store uploads/backups in MySQL:
# STORE_FILES_IN_DB=1

# Optional: how many ZIP backups to keep (default 14 on disk, 7 in cloud mode)
# BACKUP_KEEP=14

# Hosting:
#   Oracle VM (more storage): docs/HOSTING-ORACLE.md
#   Aiven 1GB + Render:       docs/HOSTING.md
# Export:  npm run export:snapshot
# Restore: npm run restore:backup -- .\EyeClinic-Backup-....zip
