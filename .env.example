# Copy to .env and fill in your MySQL password
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=eye_clinic

# Clinic login password (app UI)
CLINIC_PASSWORD=clinic123

# On hosts with ephemeral disks (e.g. Render), store uploads/backups in MySQL:
# STORE_FILES_IN_DB=1
#
# Cloud hosting steps: docs/HOSTING.md
# Export local data: npm run export:snapshot
# Import to Aiven: set MYSQL_* to cloud + STORE_FILES_IN_DB=1, then
#   node scripts/migrate-sqlite-to-mysql.mjs .\data\backups\snapshot.json
