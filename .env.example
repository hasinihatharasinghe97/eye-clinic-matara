# Copy to .env and fill in values.
# .env is gitignored — never commit real passwords.

# --- Local MySQL (clinic PC) ---
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=root
# MYSQL_DATABASE=eye_clinic
# (leave STORE_FILES_IN_DB unset for local disk uploads)

# --- Oracle HeatWave via NLB (Render cloud) ---
MYSQL_HOST=YOUR_NLB_PUBLIC_IP
MYSQL_PORT=3306
MYSQL_USER=clinicadmin
MYSQL_PASSWORD=YOUR_HEATWAVE_PASSWORD
MYSQL_DATABASE=eye_clinic
MYSQL_SSL=1
STORE_FILES_IN_DB=1

# Clinic login password (app UI)
CLINIC_PASSWORD=clinic123

# Optional: how many ZIP backups to keep (default 7 in cloud, 14 on disk)
# BACKUP_KEEP=7

# Hosting: docs/HOSTING.md
# Export local → import HeatWave:
#   npm run export:local
#   npm run import:heatwave
