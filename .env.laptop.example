# Clinic laptop (works with no internet). Copy this file to .env on the laptop.
# .env is gitignored — never commit real passwords.
#
# The laptop uses its OWN MySQL database (MYSQL_*). At the end of the day,
# "Sync to cloud" makes the HeatWave database (CLOUD_MYSQL_*) an exact copy of it,
# so the online app shows the same records. Setup guide: docs/OFFLINE-LAPTOP.md

# --- This laptop's database (MySQL installed on the laptop) ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=YOUR_LOCAL_MYSQL_PASSWORD
MYSQL_DATABASE=eye_clinic
MYSQL_SSL=0
# Photos and backups are kept as files on the laptop (leave this 0)
STORE_FILES_IN_DB=0

# --- Cloud database the laptop syncs to (Oracle HeatWave, same values the online app uses) ---
CLOUD_MYSQL_HOST=138.2.88.122
CLOUD_MYSQL_PORT=3306
CLOUD_MYSQL_USER=clinicadmin
CLOUD_MYSQL_PASSWORD=YOUR_HEATWAVE_PASSWORD
CLOUD_MYSQL_DATABASE=eye_clinic
CLOUD_MYSQL_SSL=1

# Clinic login password on the laptop (app UI)
CLINIC_PASSWORD=clinic123

# Optional: how many ZIP backups to keep on the laptop (default 14)
# BACKUP_KEEP=14
