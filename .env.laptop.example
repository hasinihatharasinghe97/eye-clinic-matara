# Clinic laptop (works with no internet). Copy this file to .env on the laptop.
# .env is gitignored — never commit real passwords.
#
# The laptop uses its OWN MySQL database (MYSQL_*). Whenever it has a stable internet
# connection, it syncs automatically BOTH WAYS with the HeatWave database (CLOUD_MYSQL_*):
# work done on the laptop goes up, changes made in the online app come down.
# New records get even numbers here and odd numbers online, so they never clash.
# Setup guide: docs/OFFLINE-LAPTOP.md

# --- This laptop's database (MySQL installed on the laptop) ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=YOUR_LOCAL_MYSQL_PASSWORD
MYSQL_DATABASE=eye_clinic
MYSQL_SSL=0
# Photos and backups are kept as files on the laptop (leave this 0)
STORE_FILES_IN_DB=0

# --- Cloud database the laptop syncs to (Oracle HeatWave, same values the online app uses) ---
CLOUD_MYSQL_HOST=138.2.88.122
CLOUD_MYSQL_PORT=3306
CLOUD_MYSQL_USER=YOUR_HEATWAVE_USER_NAME
CLOUD_MYSQL_PASSWORD=YOUR_HEATWAVE_PASSWORD
CLOUD_MYSQL_DATABASE=eye_clinic
CLOUD_MYSQL_SSL=1

# Clinic login password on the laptop (app UI)
CLINIC_PASSWORD=clinic123

# Optional: how many ZIP backups to keep on the laptop (default 14)
# BACKUP_KEEP=14

# Automatic two-way sync while the app is open (on by default). Each check is a quick
# comparison; it only syncs when something changed on either side, and only after the
# cloud answered quickly 3 times in a row.
# CLOUD_AUTO_SYNC=0              # turn automatic sync off (manual "Sync now" only)
# CLOUD_AUTO_SYNC_MINUTES=2      # how often to check
# CLOUD_SYNC_STABLE_CHECKS=3     # quick connection checks (5 s apart) required before syncing
