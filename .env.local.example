# Local testing only — overrides .env (HeatWave / cloud).
# Copy to .env.local (gitignored) or run:  copy .env.local.example .env.local
#
# 1) Start DB:  docker compose up -d
# 2) Start app: start-clinic.bat   OR   npm run dev

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=eye_clinic

# Important: do NOT use cloud file storage for local
# (leave STORE_FILES_IN_DB unset / empty)
STORE_FILES_IN_DB=
MYSQL_SSL=

CLINIC_PASSWORD=clinic123
